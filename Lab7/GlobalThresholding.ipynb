   "source": [
    "import cv2\n",
    "\n",
    "img = cv2.imread(\"assets/Fruit3.jpg\",0)\n",
    "\n",
    "# Initial Threshold 50, can increase it or decrease it to study the effect\n",
    "_,thresh=cv2.threshold(img,50,255,cv2.THRESH_BINARY)\n",
    "\n",
    "cv2.imshow(\"Threshold\",thresh)\n",
    "\n",
    "cv2.waitKey(0)\n"
   ]
  }
